CUSTOMER_API_HTTP_PORT=5001
ASPNETCORE_ENVIRONMENT=Development

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=customer_service
POSTGRES_USER=customer_service
POSTGRES_PASSWORD=customer_service_dev_password

ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=customer_service;Username=customer_service;Password=customer_service_dev_password

REDIS_PORT=6379
Redis__ConnectionString=redis:6379
CustomerCache__ExistsTtlSeconds=300

AzureBlobStorage__ConnectionString=
AzureBlobStorage__ContainerName=customer-profile-pictures
AzureBlobStorage__UploadUrlExpiresInMinutes=10

ApplicationInsights__ConnectionString=

Jwt__Issuer=CustomerService
Jwt__Audience=BankingSystem
Jwt__Secret=development-secret-for-customer-service-12345
Jwt__ExpiresInMinutes=60
